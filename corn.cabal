cabal-version:      3.14
name:               corn
version:            0.1.0.0
-- synopsis:
-- description:
license:            MIT
license-file:       LICENSE
author:             mewhhaha
maintainer:         kopatheonlyone@hotmail.com
-- copyright:
category:           Game
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md
-- extra-source-files:

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import:           warnings
    exposed-modules:  Engine.Corn
                      Engine.Corn.Prelude
                      Engine.Corn.Plugin
                      Engine.Corn.Advanced
                      Engine.Corn.Advanced.ECS
                      Engine.Corn.Advanced.FRP
                      Engine.Corn.Advanced.Input
                      Engine.Corn.Advanced.Program
                      Engine.Corn.Advanced.Route
                      Engine.Corn.Advanced.Router
                      Engine.Corn.Advanced.Scene
                      Engine.Corn.Advanced.Transform
                      Engine.Data.FRP
                      Engine.Data.ECS
                      Engine.Data.Program
                      Engine.Data.Scene
                      Engine.Data.Route
                      Engine.Data.Router
                      Engine.Data.Route.Simple
                      Engine.Data.Input
                      Engine.Data.Transform
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.21.0.0
                      , array
                      , containers
                      , parallel
                      , vector ^>=0.13
                      , rrb-vector
    hs-source-dirs:   lib
    default-language: GHC2024

test-suite corn-tests
    type:             exitcode-stdio-1.0
    hs-source-dirs:   tests
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts
    other-modules:    FRPProps
                      ECSProps
                      ProgramProps
                      SceneProps
    build-depends:    base ^>=4.21.0.0
                      , array
                      , containers
                      , parallel
                      , vector ^>=0.13
                      , rrb-vector
                      , QuickCheck
                      , corn
    default-language: GHC2024

benchmark corn-bench
    type:             exitcode-stdio-1.0
    hs-source-dirs:   bench
    main-is:          Bench.hs
    ghc-options:      -threaded -rtsopts
    build-depends:    base ^>=4.21.0.0
                      , array
                      , containers
                      , parallel
                      , vector ^>=0.13
                      , rrb-vector
                      , criterion
                      , corn
    default-language: GHC2024
